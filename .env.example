# 서버 환경변수 예시. 실제 값은 AXHub 환경변수로 등록하고 이 파일이나 코드에 쓰지 않는다.
# AI 경로: OPENROUTER_API_KEY(정식) > ANTHROPIC_API_KEY(선택, Anthropic 직접 호출) > 규칙 기반 대체 추출기.
# 둘 다 비우면 화면에 "키 미등록: 대체 추출"로 표시한다. 배포 시 사용자가 axhub env로 직접 등록한다.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# 배포 시에는 플랫폼이 주입한다(axhub.yaml의 database: engine: postgres). 직접 등록하지 않는다.
# 비워 두면 app/w07.db (로컬 SQLite). 로컬 Postgres 예: postgresql://sg:pw@localhost:55432/sumgate
# postgres:// 와 postgresql:// 는 앱이 psycopg 드라이버 주소로 바꿔 연결한다.
DATABASE_URL=
